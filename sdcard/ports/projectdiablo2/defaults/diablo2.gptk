# Xbox position names: a=south, b=east, x=west, y=north.
back = enter
start = esc
a = mouse_left
b = mouse_right
x = i
y = tab
l1 = leftshift
r1 = mouse_slow
l2 = leftalt
r2 = r
l3 = c
r3 = t
up = 1
right = 2
down = 3
left = 4
left_analog_up = mouse_movement_up
left_analog_down = mouse_movement_down
left_analog_left = mouse_movement_left
left_analog_right = mouse_movement_right
right_analog_up = f1
right_analog_right = f2
right_analog_down = f3
right_analog_left = f4
deadzone_mode = scaled_radial
deadzone = 5000
deadzone_scale = 6
deadzone_delay = 16
mouse_slow_scale = 35
